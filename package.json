{
  "name": "matjalar",
  "version": "0.1.0",
  "private": true,
  "description": "맛잘알 — 프랜차이즈 메뉴와 꿀조합 위키 (모노레포 루트)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test && node --test ./scripts/crawl-subway-catalog.test.mjs ./scripts/notify-catalog-run.test.mjs",
    "typecheck": "turbo run typecheck",
    "db:types": "corepack pnpm dlx supabase@2.98.0 gen types typescript --linked > packages/db/src/types/database.ts",
    "db:reset": "corepack pnpm dlx supabase@2.98.0 db reset",
    "db:push": "corepack pnpm dlx supabase@2.98.0 db push",
    "catalog:crawl": "node ./scripts/crawl-subway-catalog.mjs",
    "catalog:ingest": "node ./scripts/ingest-catalog-changes.mjs",
    "catalog:notify": "node ./scripts/notify-catalog-run.mjs",
    "test:catalog-crawl": "node --test ./scripts/crawl-subway-catalog.test.mjs",
    "test:catalog-notify": "node --test ./scripts/notify-catalog-run.test.mjs",
    "audit:high": "pnpm audit --audit-level=high",
    "audit:db-security": "node ./scripts/audit-local-db-security.mjs",
    "audit:service-role": "node ./scripts/audit-service-role.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\""
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "0.3.4",
      "@typescript-eslint/parser": "8.59.1",
      "esbuild": "0.25.0",
      "postcss": "8.5.10",
      "typescript": "5.7.3",
      "vite": "6.4.2"
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.59.1",
    "eslint": "9.17.0",
    "lefthook": "^1.10.0",
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.59.1"
  }
}
