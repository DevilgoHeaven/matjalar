# 맛잘알 환경 변수 템플릿
# - 실제 값은 .env.local 에 입력 (gitignore 처리됨)
# - NEXT_PUBLIC_ prefix 는 클라이언트 번들에 노출됨. 절대 SERVICE_ROLE 키에 붙이지 말 것

# === Supabase ===
# Supabase Cloud 프로젝트의 URL (예: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 서버 전용 Supabase URL. 비워두면 일부 스크립트는 NEXT_PUBLIC_SUPABASE_URL 을 사용.
SUPABASE_URL=

# Supabase anon (public) key — 클라이언트에서 사용 가능, RLS 가 데이터 보호
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
# /admin Server Action 에서만 사용. eslint + 빌드 후 grep 으로 클라이언트 누출 검사
SUPABASE_SERVICE_ROLE_KEY=

# === 운영 알림 ===
# Discord webhook (조합 등록 대기, 신고 접수, 크롤러 실패 알림용)
DISCORD_WEBHOOK_URL=

# === 분석 ===
# Plausible 도메인 (페이지뷰·트래픽 보조 지표)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# === 사이트 메타 ===
# 절대 URL (production redirect, OAuth 콜백 등에서 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === 법적 고지 ===
# /terms, /privacy 에 표시되는 운영자 정보. 실제 공개 전 반드시 채울 것.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_ADDRESS=
LEGAL_PRIVACY_OFFICER_NAME=
LEGAL_PRIVACY_OFFICER_EMAIL=
